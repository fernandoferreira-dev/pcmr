# Docker Compose Environment Configuration
# Copy this file to .env and customize values as needed

# Application Names
COMPOSE_PROJECT_NAME=pcmr

# Spring Boot API Configuration
SPRING_APPLICATION_NAME=api
SERVER_PORT=8080

# Frontend Application Ports
DESKTOP_APP_PORT=3000
MOBILE_APP_PORT=3001

# MQTT Broker Configuration
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Database Configuration (if needed in future)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=pcmr
# DB_USER=admin
# DB_PASSWORD=changeme

